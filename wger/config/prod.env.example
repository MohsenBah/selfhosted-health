# Template for wger — copied to prod.env by scripts/bootstrap.sh (prod.env is gitignored).
# Service hostnames must match compose/wger.yaml.

SECRET_KEY=replace-me-with-long-random-string
SITE_URL=http://localhost:8080
TIME_ZONE=America/Toronto
TZ=America/Toronto

ALLOW_REGISTRATION=True
ALLOW_GUEST_USERS=False
ALLOW_UPLOAD_VIDEOS=True

WGER_INSTANCE=https://wger.de
SYNC_EXERCISES_CELERY=True
SYNC_EXERCISE_IMAGES_CELERY=True
SYNC_EXERCISE_VIDEOS_CELERY=False
SYNC_INGREDIENTS_CELERY=True
DOWNLOAD_INGREDIENTS_FROM=WGER

USE_CELERY=True
CELERY_BROKER=redis://wger-cache:6379/2
CELERY_BACKEND=redis://wger-cache:6379/2
CELERY_WORKER_CONCURRENCY=2

# Django reads PS_DATABASE_URI when set (see wger settings/main.py)
POSTGRES_USER=wger
POSTGRES_PASSWORD=change-me-wger-db
POSTGRES_DB=wger
PS_DATABASE_URI=postgres://wger:change-me-wger-db@wger-db:5432/wger

DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_DATABASE=wger
DJANGO_DB_USER=wger
DJANGO_DB_PASSWORD=change-me-wger-db
DJANGO_DB_HOST=wger-db
DJANGO_DB_PORT=5432
DJANGO_PERFORM_MIGRATIONS=True

DJANGO_CACHE_BACKEND=django_redis.cache.RedisCache
DJANGO_CACHE_LOCATION=redis://wger-cache:6379/1
DJANGO_CACHE_TIMEOUT=1296000
DJANGO_CACHE_CLIENT_CLASS=django_redis.client.DefaultClient

DJANGO_DEBUG=False
WGER_USE_GUNICORN=True
WGER_PORT=8000

AXES_ENABLED=True
AXES_FAILURE_LIMIT=10
AXES_COOLOFF_TIME=30
AXES_HANDLER=axes.handlers.cache.AxesCacheHandler

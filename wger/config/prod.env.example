# Template for wger — copied to prod.env by scripts/bootstrap.sh (prod.env is gitignored).
# Service hostnames must match compose/wger.yaml.
#
# IMPORTANT: POSTGRES_* / DJANGO_DB_* / PS_DATABASE_URI passwords must match
# WGER_DB_PASSWORD in the repo-root .env (bootstrap re-syncs them when you re-run it).
#
# Browser entrypoint is nginx on WGER_HTTP_PORT (default 8080), not gunicorn :8000.
# Set SITE_URL (and CSRF_TRUSTED_ORIGINS if needed) to the URL you actually open.

SECRET_KEY=replace-me-with-long-random-string
# Must be the public URL you open in the browser (https via NPM).
SITE_URL=https://<your-domain>.com
CSRF_TRUSTED_ORIGINS=https://<your-domain>.com,http://192.168.4.185:8080
# Required behind NPM → nginx so Django builds https:// media/API links
X_FORWARDED_PROTO_HEADER_SET=True
USE_X_FORWARDED_HOST=True
# NPM + compose nginx = 2 hops (optional but correct)
NUMBER_OF_PROXIES=2
TIME_ZONE=America/Toronto
TZ=America/Toronto

ALLOW_REGISTRATION=True
ALLOW_GUEST_USERS=False
ALLOW_UPLOAD_VIDEOS=True

WGER_INSTANCE=https://wger.de
# Keep first boot light on small CTs; turn images/ingredients on later via Celery if wanted.
SYNC_EXERCISES_CELERY=True
SYNC_EXERCISE_IMAGES_CELERY=False
SYNC_EXERCISE_VIDEOS_CELERY=False
SYNC_INGREDIENTS_CELERY=False
DOWNLOAD_INGREDIENTS_FROM=WGER

USE_CELERY=True
CELERY_BROKER=redis://wger-cache:6379/2
CELERY_BACKEND=redis://wger-cache:6379/2
CELERY_WORKER_CONCURRENCY=2

# Django reads PS_DATABASE_URI when set (see wger settings/main.py)
POSTGRES_USER=wger
POSTGRES_PASSWORD=change-me-wger-db
POSTGRES_DB=wger
PS_DATABASE_URI=postgres://wger:change-me-wger-db@wger-db:5432/wger

DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_DATABASE=wger
DJANGO_DB_USER=wger
DJANGO_DB_PASSWORD=change-me-wger-db
DJANGO_DB_HOST=wger-db
DJANGO_DB_PORT=5432
DJANGO_PERFORM_MIGRATIONS=True

DJANGO_CACHE_BACKEND=django_redis.cache.RedisCache
DJANGO_CACHE_LOCATION=redis://wger-cache:6379/1
DJANGO_CACHE_TIMEOUT=1296000
DJANGO_CACHE_CLIENT_CLASS=django_redis.client.DefaultClient

DJANGO_DEBUG=False
WGER_USE_GUNICORN=True
WGER_PORT=8000
GUNICORN_CMD_ARGS=--workers 2 --threads 2 --worker-class gthread --timeout 240

FROM_EMAIL=wger Workout Manager <wger@localhost>

AXES_ENABLED=True
AXES_FAILURE_LIMIT=10
AXES_COOLOFF_TIME=30
AXES_HANDLER=axes.handlers.cache.AxesCacheHandler

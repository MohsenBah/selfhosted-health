# Root env for docker compose variable substitution.
# Copy to .env and fill in. Never commit .env.

TZ=America/Toronto

# --- Open Wearables ---
OW_DB_NAME=open-wearables
OW_DB_USER=open-wearables
OW_DB_PASSWORD=change-me-ow-db
OW_DB_PORT=5432
OW_API_PORT=8000
OW_UI_PORT=3000
# Browser-facing API URL (UI calls this). Must be reachable from the browser.
# LAN:  http://192.168.4.185:8000
# NPM:  https://gym-sync-api.<your-domain>.com   ← required if UI is served over HTTPS
OW_PUBLIC_API_URL=http://localhost:8000

# --- wger ---
WGER_DB_NAME=wger
WGER_DB_USER=wger
WGER_DB_PASSWORD=change-me-wger-db
WGER_DB_PORT=5433
WGER_HTTP_PORT=8080

# --- Grafana (only needed for --profile grafana or --profile full) ---
# Safe to omit/comment when using an external Grafana (wearables + gym only).
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-me-grafana
# GRAFANA_PORT=3001
# GRAFANA_ROOT_URL=http://localhost:3001
